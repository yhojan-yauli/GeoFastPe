# Copia este archivo a .env (local) y completa los valores.
# .env NO se sube a git. En Render, pon estas mismas variables en
# Environment > Environment Variables (las de Render tienen prioridad).

# ==========================
# Base de datos (TiDB, compatible con MySQL)
# ==========================
SPRING_PROFILES_ACTIVE=mysql
DB_URL=jdbc:mysql://TU_HOST_TIDB:4000/TU_BASE_DE_DATOS?sslMode=VERIFY_IDENTITY&serverTimezone=UTC
DB_USERNAME=TU_USUARIO_TIDB
DB_PASSWORD=TU_PASSWORD_TIDB
JPA_DDL_AUTO=update

# ==========================
# JWT (genera un valor largo y aleatorio, minimo 32 caracteres)
# ==========================
JWT_SECRET=CAMBIA_ESTO_POR_UN_SECRETO_LARGO_Y_ALEATORIO
JWT_EXPIRATION_MS=86400000

# ==========================
# CORS: origenes que pueden llamar a la API (separados por coma)
# Incluye el origen del frontend web y el de la app Android (Capacitor)
# ==========================
CORS_ALLOWED_ORIGINS=https://TU_FRONTEND.onrender.com,http://localhost:5173,https://localhost,capacitor://localhost

# ==========================
# Admin inicial: telefono del usuario que sera ADMIN al registrarse
# ==========================
ADMIN_PHONE=

# ==========================
# Archivos subidos (en Render el disco es efimero salvo que agregues un disco)
# ==========================
UPLOAD_DIR=uploads
